# ===========================================
# Film My Run - Environment Variables
# ===========================================

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Cloudflare R2 (Image Storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="filmmyrun-images"
R2_PUBLIC_URL="https://images.filmmyrun.co.uk"

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Shop fulfilment (same Printify account as film-my-run-merch). PRINTIFY_WEBHOOK_SECRET is
# whatever you pass to `npm run webhooks` in that project.
PRINTIFY_API_TOKEN=""
PRINTIFY_SHOP_ID=""
PRINTIFY_WEBHOOK_SECRET=""

# Google (OAuth & Sheets)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CREDENTIALS="base64-encoded-service-account-json"

# Strava (Widget)
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"
STRAVA_REFRESH_TOKEN="your-strava-refresh-token"

# Trail & Ultra News API
NEWS_API_URL=http://localhost:3000

# YouTube Data API v3 (server-side; refreshes cached view/subscriber counts)
YOUTUBE_API_KEY="your-youtube-data-api-key"

# Social posts: published news stories to the Film My Run Facebook Page + Instagram (docs/social-posts.md).
# All five are needed to post (blank = not set = nothing posted), plus the switch on /admin/social.
# Account lock: before every post Meta is asked who the two IDs are; the usernames must match the _EXPECTED
# values or nothing is posted and the switch is turned off. The token is a Page access token for the Film My
# Run Page only, never a user token. IDs and token: GitHub secrets on the news workflow.
META_FB_PAGE_ID=""
META_IG_USER_ID=""
META_FB_PAGE_ACCESS_TOKEN=""
META_FB_PAGE_USERNAME_EXPECTED="filmmyrun"
META_IG_USERNAME_EXPECTED="filmmyrun"
